# ---- LLM (optional; without a key the app runs the deterministic Level-2 path) ----
# LLM_PROVIDER: openai | anthropic | none   (openai = any OpenAI-compatible endpoint)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=                 # vision-capable model, e.g. gpt-4o-mini / claude-sonnet-4-5
LLM_BASE_URL=              # optional, OpenAI-compatible base URL (default https://api.openai.com/v1)

# ---- Photo reading (crop leaf, sick animal, Soil Health Card) ----
# VISION_PROVIDER: cline | llm | none
#   cline = send the photo to a vision model THROUGH CLINE (@cline/sdk, provider "cline", billed to Cline credits).
#           Auth: CLINE_API_KEY below, or just log in once with the Cline CLI (`cline auth`); the SDK reuses ~/.cline.
#   llm   = use LLM_PROVIDER / LLM_API_KEY above.   none = photos are not read (farmer is told; chips/typing still work).
# Unset => "llm" if an LLM key is set, else "none".
VISION_PROVIDER=none
VISION_MODEL=google/gemini-2.5-flash   # any vision model id on Cline; ~$0.001 per photo, ~5 s. Try anthropic/claude-sonnet-4.5 for harder cards

# ---- Cline SDK inside the product (@cline/sdk) ----
CLINE_MODE=fixture         # fixture | sdk
CLINE_PROVIDER=anthropic   # providerId passed to ClineCore.start
CLINE_MODEL=claude-sonnet-4-5
CLINE_API_KEY=
CLINE_TIMEOUT_MS=20000

# ---- Voice (server-side speech recognition) ----
# local  = FREE open-source Whisper running inside this server (no key; model downloads once to data/models/)
# openai = paid OpenAI Whisper API (needs WHISPER_API_KEY)   none = off (typing + chips only)
STT_PROVIDER=local
WHISPER_LOCAL_MODEL=onnx-community/whisper-small  # ~500 MB one-time download, ~2 s per clip, correct Hindi script. whisper-base (~150 MB) is faster but wrote Hindi in Urdu script in our test
STT_WARMUP=true            # load the model at server start so the first mic tap is quick
WHISPER_API_KEY=           # only for STT_PROVIDER=openai
BHASHINI_USER_ID=          # reserved (not wired in MVP)
BHASHINI_API_KEY=

# ---- Data feeds ----
DATA_GOV_IN_API_KEY=       # mandi dataset; empty => snapshot CSV (stale:true)
MANDI_MODE=auto            # auto | live | snapshot
WEATHER_MODE=auto          # auto | live | cached
TRANSPORT_RATE_PER_Q_KM=2  # explicit assumption (INR per quintal per km), shown in UI

# ---- Demo ----
DEMO_NOW=2026-10-10T02:00:00+05:30   # freeze clock for countdowns; empty => real time
PORT=8787
